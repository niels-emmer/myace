{
  "rules": [
    {
      "capability": "execute",
      "effect": "ask",
      "match": "git push *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "git reset --hard *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "rm -rf *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "sudo *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "terraform apply *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "terraform destroy *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "tofu apply *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "tofu destroy *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "pulumi up *"
    },
    {
      "capability": "execute",
      "effect": "ask",
      "match": "pulumi destroy *"
    }
  ]
}

# ─── Application ──────────────────────────────────────────────
APP_NAME=MyACE
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string
DEBUG=true

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=myace
POSTGRES_PASSWORD=myace_secret
POSTGRES_DB=myace
DATABASE_URL=postgresql+asyncpg://myace:myace_secret@postgres:5432/myace

# ─── OIDC / OAuth2 ───────────────────────────────────────────
# Primary OIDC provider (Authentik, Keycloak, etc.)
OIDC_CLIENT_ID=myace
OIDC_CLIENT_SECRET=change-me
OIDC_ISSUER_URL=https://auth.myace.local/application/o/myace/
OIDC_SCOPES=openid profile email

# GitHub OAuth (fallback/secondary)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (fallback/secondary)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── API Keys ─────────────────────────────────────────────────
API_KEY_SALT=change-me-to-a-random-salt
API_KEY_LENGTH=48

# ─── Admin bootstrap ──────────────────────────────────────────
# Comma-separated emails auto-promoted to admin on register/login.
# The very first user to ever register is always made admin too.
ADMIN_EMAILS=

# ─── Traefik ──────────────────────────────────────────────────
TRAEFIK_ADMIN_USER=admin
# Generate with: htpasswd -nb admin yourpassword
TRAEFIK_ADMIN_PASSWORD_HASH=

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=https://myace.localhost

# ─── Doc Cache ────────────────────────────────────────────────
DOC_CACHE_TTL_DAYS=7
DOC_CACHE_REFRESH_INTERVAL_HOURS=168

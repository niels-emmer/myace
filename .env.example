# ─── Application ──────────────────────────────────────────────
APP_NAME=MyACE
# `development` (default) turns OFF the production hardening checks — the
# default-secret and TRUSTED_HOSTS startup errors, and it auto-creates the
# schema on every boot. Set to `production` for any deployment reachable
# beyond localhost (and run `alembic upgrade head` yourself).
APP_ENV=development
# MUST change before any public/non-localhost deployment — forges session
# cookies otherwise. Generate with: openssl rand -hex 32
APP_SECRET_KEY=change-me-to-a-random-64-char-string
# MUST be false for any deployment reachable beyond localhost — the app
# REFUSES TO START with DEBUG=true outside APP_ENV=development. DEBUG is the
# shipped development default, so this is a tripwire for an unreviewed .env
# copy. (/docs and /redoc are gated on APP_ENV, not DEBUG.)
DEBUG=true
# Log every SQL statement (bound parameters are never logged). Off by default.
# SQL_ECHO=false

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=myace
# MUST change before any public/non-localhost deployment.
POSTGRES_PASSWORD=myace_secret
POSTGRES_DB=myace
DATABASE_URL=postgresql+asyncpg://myace:myace_secret@postgres:5432/myace

# ─── Postgres Backups ─────────────────────────────────────────
# Schedule uses standard cron format or @daily/@weekly/@monthly.
# Retention: dumps older than BACKUP_KEEP_DAYS are pruned daily;
# weekly/monthly dumps are kept for BACKUP_KEEP_WEEKS/MONTHS.
# These are commented out because the compose file provides sensible
# defaults — uncomment to override.
# SCHEDULE=@daily
# BACKUP_KEEP_DAYS=7
# BACKUP_KEEP_WEEKS=4
# BACKUP_KEEP_MONTHS=6

# ─── OIDC / OAuth2 ───────────────────────────────────────────
# Primary OIDC provider (Authentik, Keycloak, etc.)
OIDC_CLIENT_ID=myace
OIDC_CLIENT_SECRET=change-me
OIDC_ISSUER_URL=https://auth.myace.local/application/o/myace/
OIDC_SCOPES=openid profile email

# GitHub OAuth (fallback/secondary)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (fallback/secondary)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Auth rate limits ─────────────────────────────────────────
# Per client IP, slowapi syntax. Applies to login/register/password-reset and
# (tighter) TOTP checks. In-memory and per-process: with N backend replicas the
# effective limit is N times this.
# AUTH_RATE_LIMIT=10/minute
# MFA_RATE_LIMIT=5/minute

# ─── API Keys ─────────────────────────────────────────────────
API_KEY_LENGTH=48

# ─── Admin bootstrap ──────────────────────────────────────────
# Comma-separated emails auto-promoted to admin on register/login.
ADMIN_EMAILS=
# While true, the first-ever registered user becomes admin (the only way to
# get an admin on a fresh database). On a public deployment, set this to
# false in .env immediately after creating your own admin account — anyone
# who registers before you otherwise becomes admin.
ADMIN_BOOTSTRAP_ENABLED=true

# ─── Reverse proxy network ────────────────────────────────────
# External Docker network the reverse proxy joins (docker-compose.prod.yml).
# Defaults to `proxy-net` when unset.
# PROXY_NETWORK=proxy-net

# ─── Scanner / starter collections ────────────────────────────
# Root the local-directory scanner is confined to. The dev compose file mounts
# the host home at /host-home; running uvicorn from backend/ use an absolute path.
# SCAN_ROOT=/host-home
# Directory the starter-pack seeder reads. The compose files mount the repo's
# collections/ at /app/collections; running from backend/ use ../collections.
# COLLECTIONS_ROOT=/app/collections
# Wall-clock cap on a git-source scan's shallow clone, in seconds.
# GIT_CLONE_TIMEOUT_SECONDS=60
# Upstream repo the GitHub-export/community UI targets.
# COMMUNITY_REPO=nemmer/MyACE

# ─── CORS ─────────────────────────────────────────────────────
# Set to your real public origin(s) before deploying (comma-separated if
# frontend/backend are on different subdomains). See the nginx-proxy-manager
# section in README.md for a worked example. Do NOT use "*": with
# allow_credentials=True the app refuses to start on a wildcard outside
# APP_ENV=development (it would let any website read authenticated responses).
CORS_ORIGINS=https://myace.localhost

# ─── Trusted hosts ────────────────────────────────────────────
# Comma-separated Host headers to accept. Empty disables the check (default,
# fine for local/dev). Set to your real domain(s) for a public deployment.
TRUSTED_HOSTS=

# ─── Doc Cache ────────────────────────────────────────────────
DOC_CACHE_TTL_DAYS=7
DOC_CACHE_REFRESH_INTERVAL_HOURS=168

# ─── Security — encrypted admin secrets ────────────────────────
# Symmetric key used to encrypt admin-editable secrets (SMTP password,
# OAuth client secrets) saved via System Settings before storing them in
# the database. Required before those forms can be saved. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SETTINGS_ENCRYPTION_KEY=

# Base URL of the frontend, used to build links in outgoing emails (e.g.
# the password-reset link). Set to your real public frontend origin for
# any non-localhost deployment. It also decides whether the session cookie
# carries the Secure flag: an https:// value sets it, http:// clears it, and a
# non-https value outside APP_ENV=development logs a startup warning.
FRONTEND_BASE_URL=http://localhost:5173

# ─── Community collection freshness ────────────────────────────
# How many days a manual last_verified_at is considered current before
# GET /admin/freshness-queue and the weekly check_collection_freshness.py
# digest script flag a collection for re-review. Default ~6 months.
COLLECTION_FRESHNESS_THRESHOLD_DAYS=180

# ─── SMTP (password-reset email) ───────────────────────────────
# All of these can also be set via System Settings in the admin UI — a
# value saved there overrides the env var at runtime. Leave SMTP_HOST
# empty to leave email disabled until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MyACE
SMTP_USE_TLS=true

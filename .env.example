# ─── Application ──────────────────────────────────────────────
APP_NAME=MyACE
APP_ENV=development
# MUST change before any public/non-localhost deployment — forges session
# cookies otherwise. Generate with: openssl rand -hex 32
APP_SECRET_KEY=change-me-to-a-random-64-char-string
# MUST be false for any deployment reachable beyond localhost — true
# exposes /docs and /redoc publicly and disables secure-only cookies.
DEBUG=true

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=myace
# MUST change before any public/non-localhost deployment.
POSTGRES_PASSWORD=myace_secret
POSTGRES_DB=myace
DATABASE_URL=postgresql+asyncpg://myace:myace_secret@postgres:5432/myace

# ─── OIDC / OAuth2 ───────────────────────────────────────────
# Primary OIDC provider (Authentik, Keycloak, etc.)
OIDC_CLIENT_ID=myace
OIDC_CLIENT_SECRET=change-me
OIDC_ISSUER_URL=https://auth.myace.local/application/o/myace/
OIDC_SCOPES=openid profile email

# GitHub OAuth (fallback/secondary)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth (fallback/secondary)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── API Keys ─────────────────────────────────────────────────
API_KEY_LENGTH=48

# ─── Admin bootstrap ──────────────────────────────────────────
# Comma-separated emails auto-promoted to admin on register/login.
ADMIN_EMAILS=
# While true, the first-ever registered user becomes admin (the only way to
# get an admin on a fresh database). On a public deployment, set this to
# false in .env immediately after creating your own admin account — anyone
# who registers before you otherwise becomes admin.
ADMIN_BOOTSTRAP_ENABLED=true

# ─── Traefik ──────────────────────────────────────────────────
TRAEFIK_ADMIN_USER=admin
# Generate with: htpasswd -nb admin yourpassword
TRAEFIK_ADMIN_PASSWORD_HASH=

# ─── CORS ─────────────────────────────────────────────────────
# Set to your real public origin(s) before deploying (comma-separated if
# frontend/backend are on different subdomains). See the nginx-proxy-manager
# section in README.md for a worked example.
CORS_ORIGINS=https://myace.localhost

# ─── Trusted hosts ────────────────────────────────────────────
# Comma-separated Host headers to accept. Empty disables the check (default,
# fine for local/dev). Set to your real domain(s) for a public deployment.
TRUSTED_HOSTS=

# ─── Doc Cache ────────────────────────────────────────────────
DOC_CACHE_TTL_DAYS=7
DOC_CACHE_REFRESH_INTERVAL_HOURS=168
